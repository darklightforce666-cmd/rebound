# REBOUND V3 worker host (compose.rewards.yml). Copy to .env.worker on the worker host only.
# Public addresses and paths only: key files and database URLs live in ./runtime-secrets
# (created by scripts/rewards/keygen-v3.cjs and scripts/rewards/db-login.cjs, mode 600).

# ---- Solana ----
SOLANA_RPC_URL=                     # mainnet HTTPS RPC with archival history (Alchemy); never commit it
HISTORY_RPC_URL=                    # optional separate archival endpoint (defaults to SOLANA_RPC_URL)
VERIFIER_RPC_URL=                   # optional independent RPC for the verifier's re-measurement
HISTORY_RPC_MIN_INTERVAL_MS=100
REWARDS_GENESIS_HASH=5eykt4UsFv8P8NJdTREpY1vzqKqZKvdpKuc147dw2N9d   # mainnet; the scheduler refuses any other chain

# ---- SOL/USD (Pyth) ----
# Recommended: a Pyth API key (Hermes/Benchmarks require one since 2026-08-26). With it the indexer samples
# fresh prices and backfills purchase times; without it only the on-chain feed (~53 s cadence, policy max age
# 30 s) is used and purchases between updates stay on hold (never priced at zero).
PYTH_API_KEY=
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_BENCHMARKS_URL=https://benchmarks.pyth.network

# ---- Program V3 (public addresses; must equal the on-chain deployment or the scheduler will not sign) ----
REWARDS_PROGRAM_ID=
REWARDS_PUBLISHER_ADDRESS=
REWARDS_VERIFIER_ADDRESS=
REWARDS_FEE_PAYER_ADDRESS=
# Key files are mounted at /run/secrets by compose (publisher.json, verifier.json, fee_payer.json).

# ---- Safety ----
REWARDS_MAX_EXECUTION_MODE=dry_run  # dry_run → mainnet_test only after the owner sets wallets + a spending budget
REWARDS_ALLOW_PRODUCTION=false      # never true for a private test
REWARDS_SPONSOR_RENT=false          # true: fee payer covers rent for awards below the rent-exempt minimum
REWARDS_MIN_BUYBACK_LAMPORTS=5000000

# ---- Database logins (files, see scripts/rewards/db-login.cjs) ----
# INDEXER_DATABASE_URL_FILE / SCHEDULER_DATABASE_URL_FILE / VERIFIER_DATABASE_URL_FILE are set by compose.
