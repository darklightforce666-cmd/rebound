{
  "name": "rebound-solana",
  "version": "0.6.0",
  "private": true,
  "description": "Pump.fun launchpad development with live Solana data and creator-fee reward infrastructure",
  "scripts": {
    "start": "node scripts/build.cjs && node scripts/server.cjs",
    "build": "node scripts/build.cjs",
    "test": "node scripts/test.cjs",
    "rewards:migrate": "node scripts/rewards/manage.cjs migrate",
    "rewards:dry-run": "node scripts/rewards/manage.cjs dry-run",
    "rewards:preflight": "node scripts/rewards/manage.cjs preflight",
    "rewards:worker": "node server/rewards/worker-v3.cjs",
    "rewards:governance": "node scripts/rewards/governance-v3.cjs",
    "rewards:keygen": "node scripts/rewards/keygen-v3.cjs",
    "rewards:db-login": "node scripts/rewards/db-login.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@netlify/blobs": "11.1.0",
    "@noble/curves": "1.9.7",
    "@privy-io/react-auth": "3.45.0",
    "@pump-fun/pump-sdk": "2.0.0",
    "@pump-fun/pump-swap-sdk": "1.20.0",
    "@solana-program/memo": "^0.15.0",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.99.0",
    "@supabase/supabase-js": "2.117.2",
    "bs58": "4.0.1",
    "lightweight-charts": "5.2.1",
    "pg": "8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@solana/kit": "8.3.0",
    "esbuild": "0.28.2",
    "https-proxy-agent": "7.0.6",
    "litesvm": "1.4.1",
    "playwright-core": "1.63.0",
    "ws": "8.21.3"
  }
