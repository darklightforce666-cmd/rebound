# REBOUND configuration template. Names and descriptions only — never commit real values.
# Browser-visible values are marked PUBLIC. Everything else is server/worker-only; never prefix
# server values with VITE_, NEXT_PUBLIC_ or PUBLIC_.

# ---- Website / origins ----
PUBLIC_SITE_ORIGIN=https://rebound.wtf
# Comma-separated additional HTTPS origins allowed to call mutations (Netlify previews, local dev).
ALLOWED_ORIGINS=
NODE_VERSION=24
# Set in the Netlify UI/API, not netlify.toml. Redeploy after changing it.
AWS_LAMBDA_JS_RUNTIME=nodejs24.x

# ---- Supabase (project zuvefozubbgstyljfxjh) ----
SUPABASE_URL=https://zuvefozubbgstyljfxjh.supabase.co            # PUBLIC
SUPABASE_PUBLISHABLE_KEY=                                         # PUBLIC (sb_publishable_…)
SUPABASE_SECRET_KEY=                                              # Netlify API only: Storage uploads (sb_secret_…)
# Scoped Postgres logins (see docs/SUPABASE-SETUP.md §2). Transaction pooler for the API.
DATABASE_URL=                                                     # rebound_api_login (Netlify)
INDEXER_DATABASE_URL=                                             # rebound_indexer_login (worker)
SCHEDULER_DATABASE_URL=                                           # rebound_scheduler_login (worker)
VERIFIER_DATABASE_URL=                                            # rebound_verifier_login (verifier)

# ---- Privy (wallet discovery/connection only) ----
PRIVY_APP_ID=                                                     # PUBLIC

# ---- Solana ----
SOLANA_RPC_URL=                                                   # HTTPS, finalized reads (server/worker)
SOLANA_WS_URL=                                                    # WSS hints only (worker)
HISTORY_RPC_URL=                                                  # archival getSignaturesForAddress/getTransaction
REWARDS_GENESIS_HASH=5eykt4UsFv8P8NJdTREpY1vzqKqZKvdpKuc147dw2N9d

# ---- SOL/USD (Pyth; see docs/POLICY-V3.md) ----
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_BENCHMARKS_URL=https://benchmarks.pyth.network

# ---- REBOUND program V3 (filled at M3/M6 after deployment) ----
REWARDS_PROGRAM_ID=
REWARDS_PUBLISHER_ADDRESS=
REWARDS_VERIFIER_ADDRESS=
REWARDS_GUARDIAN_ADDRESS=
REWARDS_GOVERNANCE_ADDRESS=
REWARDS_FEE_PAYER_ADDRESS=
# Worker hosts only: signer files mounted from a secret manager (never in the repo or Supabase).
REWARDS_PUBLISHER_KEY_FILE=/run/secrets/publisher.json
REWARDS_VERIFIER_KEY_FILE=/run/secrets/verifier.json
REWARDS_FEE_PAYER_KEY_FILE=/run/secrets/fee-payer.json
# Automatic primary funding: master key that decrypts the imported dev-wallet signer record.
# Only on the scheduler host; never in Supabase or Netlify.
REWARDS_SIGNER_MASTER_KEY_FILE=/run/secrets/signer-master.key

# ---- Services ----
REWARDS_INTERNAL_SECRET=                                          # HMAC for worker↔verifier (≥32 random bytes)
REWARDS_VERIFIER_URL=http://verifier:8788
BIND_ADDRESS=0.0.0.0
PORT=8788

# ---- Execution mode (database reward_platform is authoritative; this is a hard ceiling) ----
# dry_run | mainnet_test | production. Workers refuse to sign above this ceiling.
REWARDS_MAX_EXECUTION_MODE=dry_run
